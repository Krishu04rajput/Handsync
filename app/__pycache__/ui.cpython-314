QMainWindow, QWidget#root { background:#0b0f17; }
QWidget { color:#d6e2f0; font-family:'Segoe UI','Inter',sans-serif; font-size:12px; }
QFrame#card { background:#121926; border:1px solid #1f2b3d; border-radius:10px; }
QLabel#cardTitle { color:#4cc9f0; font-weight:700; letter-spacing:2px; font-size:11px; }
QLabel#appTitle { font-size:28px; font-weight:800; color:#e8f4ff; letter-spacing:7px; }
QLabel#appSubtitle { color:#4cc9f0; letter-spacing:3px; font-size:11px; }
QLabel#video { background:#05080d; border:1px solid #1f2b3d; border-radius:10px; }
QLabel#banner { font-size:16px; font-weight:800; letter-spacing:2px; padding:8px; border-radius:8px; }
QLabel#banner[level="info"] { background:#0e3a4a; color:#aef0ff; border:1px solid #4cc9f0; }
QLabel#banner[level="err"] { background:#5c0f1c; color:#ffd5dc; border:2px solid #ff4d6a; }
QLabel#badge { padding:3px 10px; border-radius:10px; font-weight:700; border:1px solid #3a4a60;
               background:#182233; color:#9fb3c8; }
QLabel#badge[level="ok"]   { background:#0f3d2e; color:#46e8ab; border-color:#46e8ab; }
QLabel#badge[level="warn"] { background:#443300; color:#ffd24a; border-color:#ffd24a; }
QLabel#badge[level="err"]  { background:#4a0f1b; color:#ff7a90; border-color:#ff7a90; }
QLabel#badge[level="info"] { background:#0e3a4a; color:#7fdcff; border-color:#4cc9f0; }
QLabel#msg { color:#9fb3c8; }
QPushButton { background:#182233; border:1px solid #2b3b52; border-radius:6px; padding:7px 10px; font-weight:600; }
QPushButton:hover { border-color:#4cc9f0; }
QPushButton:disabled { color:#5b6b7f; background:#10161f; border-color:#1b2535; }
QPushButton:checked { background:#0e3a4a; border-color:#4cc9f0; color:#aef0ff; }
QPushButton#primary { background:#0d6e86; border-color:#4cc9f0; color:white; }
QPushButton#estop { background:#b3122a; border:2px solid #ff4d6a; color:white; font-size:15px;
                    font-weight:800; padding:14px; letter-spacing:2px; }
QPushButton#estop:hover { background:#d4163a; }
QPushButton#resume { background:#b36b00; border:2px solid #ffd24a; color:white; font-weight:800; padding:10px; }
QComboBox, QSpinBox { background:#0e1520; border:1px solid #2b3b52; border-radius:6px; padding:4px 8px; }
QComboBox QAbstractItemView { background:#0e1520; selection-background-color:#0d6e86; }
QSlider::groove:horizontal { height:6px; background:#1f2b3d; border-radius:3px; }
QSlider::sub-page:horizontal { background:#4cc9f0; border-radius:3px; }
QSlider::handle:horizontal { background:#e8f4ff; width:14px; margin:-5px 0; border-radius:7px; }
QSlider::handle:horizontal:disabled { background:#4b5a6e; }
QScrollArea { border:none; background:transparent; }
QCheckBox { spacing:8px; }
