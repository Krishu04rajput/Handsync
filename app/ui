class MainWindow(QMainWindow):
    def __init__(self, calibration: Calibration, calibration_warnings: list[str]):
        super().__init__()
        self.setWindowTitle("HANDSYNC")
        self.resize(1360, 820)
        self.setStyleSheet(QSS)

        self.cal = calibration
        self.serial = SerialController()
        self.mapper = RobotMapper(self.cal)
        self.smoother = ServoSmoother(self.cal.home_outputs(), config.SMOOTHING_ALPHA,
                                      config.MAX_STEP_PER_UPDATE, config.DEADBAND_DEG)
        self.demo = DemoSequencer()
        self.worker: Optional[CameraWorker] = None

        self.state = DISABLED
        self.control_mode = "MIRROR"           # MIRROR (hands drive robot) | MANUAL (sliders)
        self.homing = False
        self.manual_targets: list[int] = self.cal.home_outputs()
        self._enabled_at = 0.0
        self._ignore_slider = False
        self._last_tracking_states = {"left": "LOST", "right": "LOST"}

        self._build_ui()
        self.refresh_ports()
        self._apply_calibration_to_ui()
        self._refresh_controls()
        QShortcut(QKeySequence(Qt.Key_Escape), self, activated=self.emergency_stop)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self._on_tick)
        self.timer.start(int(1000 / config.CONTROL_RATE_HZ))

        for warning in calibration_warnings:
            self.say(warning, "warn")
            QMessageBox.warning(self, "Calibration", warning)
        self.say("Ready. Start the camera first. Robot is DISABLED until you press ENABLE ROBOT.", "info")

