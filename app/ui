def set_badge(label: QLabel, text: str, level: str) -> None:
    """Coloured status pill. The text always says the status too (not colour alone)."""
    icon = {"ok": "\u25CF", "warn": "\u25B2", "err": "\u25A0", "info": "\u25CF", "off": "\u25CB"}.get(level, "")
    label.setText(f"{icon} {text}")
    label.setProperty("level", level)
    label.style().unpolish(label)
    label.style().polish(label)


def make_card(title: str) -> tuple[QFrame, QVBoxLayout]:
    frame = QFrame()
    frame.setObjectName("card")
    layout = QVBoxLayout(frame)
    layout.setContentsMargins(14, 12, 14, 12)
    layout.setSpacing(8)
    heading = QLabel(title)
    heading.setObjectName("cardTitle")
    layout.addWidget(heading)
    return frame, layout


def make_badge(text: str = "", level: str = "off") -> QLabel:
    badge = QLabel()
    badge.setObjectName("badge")
    set_badge(badge, text, level)
    return badge


# ====================================================================== calibration dialog
class CalibrationDialog(QDialog):
    """Edit min / center / max / invert / gripper open+closed for all 8 servos."""

    def __init__(self, calibration: Calibration, parent=None):
        super().__init__(parent)
        self.setWindowTitle("HANDSYNC - Servo calibration")
        self.setStyleSheet(QSS)
        self.result_calibration: Optional[Calibration] = None
        self._original = calibration
        layout = QVBoxLayout(self)
        note = QLabel("Angles are in degrees (0-180). The robot will NEVER move outside Min..Max.\n"
                      "Open/Closed apply to grippers only. 'Invert' mirrors a joint around its Center.")
        note.setObjectName("msg")
        layout.addWidget(note)
        grid = QGridLayout()
        for col, head in enumerate(("Servo", "Min", "Center", "Max", "Invert", "Open", "Closed")):
            label = QLabel(head)
            label.setObjectName("cardTitle")
            grid.addWidget(label, 0, col)
        self.fields: dict[str, dict] = {}
        for row, name in enumerate(config.SERVO_NAMES, start=1):
            cal = calibration.servos[name]
            grid.addWidget(QLabel(name.replace("_", " ").upper()), row, 0)
            widgets: dict = {}
            for col, key in enumerate(("min", "center", "max"), start=1):
                spin = QSpinBox()
                spin.setRange(0, 180)
                spin.setValue(getattr(cal, key))
                grid.addWidget(spin, row, col)
                widgets[key] = spin
            invert = QCheckBox()
            invert.setChecked(cal.invert)
            grid.addWidget(invert, row, 4)
            widgets["invert"] = invert
            if name.endswith("gripper"):
                for col, key in enumerate(("open", "closed"), start=5):
                    spin = QSpinBox()
                    spin.setRange(0, 180)
                    spin.setValue(getattr(cal, key) or 0)
                    grid.addWidget(spin, row, col)
                    widgets[key] = spin
            self.fields[name] = widgets
        layout.addLayout(grid)
        buttons = QHBoxLayout()
        save = QPushButton("SAVE")
        save.setObjectName("primary")
        cancel = QPushButton("CANCEL")
        defaults = QPushButton("RESET TO DEFAULTS")
        save.clicked.connect(self._on_save)
        cancel.clicked.connect(self.reject)
        defaults.clicked.connect(self._on_defaults)
        buttons.addWidget(defaults)
        buttons.addStretch(1)
        buttons.addWidget(cancel)
        buttons.addWidget(save)
        layout.addLayout(buttons)

    def _on_defaults(self) -> None:
        default = Calibration.default()
        for name, widgets in self.fields.items():
            cal = default.servos[name]
            for key, widget in widgets.items():
                value = getattr(cal, key)
                if isinstance(widget, QCheckBox):
                    widget.setChecked(bool(value))
                else:
                    widget.setValue(value or 0)

    def _on_save(self) -> None:
        data: dict = self._original.to_dict()
        for name, widgets in self.fields.items():
            entry = {"invert": widgets["invert"].isChecked()}
            for key in ("min", "center", "max", "open", "closed"):
                if key in widgets:
                    entry[key] = widgets[key].value()
            data[name] = entry
        try:
            self.result_calibration = Calibration.from_dict(data)
        except CalibrationError as exc:
            QMessageBox.warning(self, "Invalid calibration", str(exc))
            return
        self.accept()


