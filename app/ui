    # ------------------------------------------------------------------ helpers
    def say(self, text: str, level: str = "info") -> None:
        color = {"info": "#9fb3c8", "warn": "#ffd24a", "err": "#ff7a90", "ok": "#46e8ab"}.get(level, "#9fb3c8")
        self.message.setStyleSheet(f"color:{color};")
        self.message.setText(text)
        log.info("UI message [%s]: %s", level, text)

    def _apply_calibration_to_ui(self) -> None:
        self._ignore_slider = True
        for name, slider in self.sliders.items():
            servo = self.cal.servos[name]
            slider.setRange(servo.min, servo.max)
            slider.setValue(self.cal.clamp(name, self.manual_targets[config.SERVO_CHANNELS[name]]))
        self._ignore_slider = False
        self.mapper.set_calibration(self.cal)
        self.swap_check.blockSignals(True)
        self.swap_check.setChecked(self.cal.swap_left_right)
        self.swap_check.blockSignals(False)
        if self.worker:
            self.worker.swap = self.cal.swap_left_right

    def _display_state(self) -> tuple[str, str]:
        if self.state == ESTOP:
            return "EMERGENCY STOP ACTIVE", "err"
        if self.state == ENABLED:
            return "ROBOT ENABLED", "ok"
        if not self.serial.is_connected:
            return "VISION ONLY", "info"
        return "ROBOT DISABLED", "warn"

    def _refresh_controls(self) -> None:
        text, level = self._display_state()
        set_badge(self.state_badge, text, level)
        estop = self.state == ESTOP
        self.enable_btn.setText("DISABLE ROBOT" if self.state == ENABLED else "ENABLE ROBOT")
        self.enable_btn.setEnabled(not estop)
        self.resume_btn.setVisible(estop)
        self.home_btn.setEnabled(not estop)
        manual = self.control_mode == "MANUAL"
        for slider in self.sliders.values():
            slider.setEnabled(manual and not estop)
        self.demo_btn.setText("STOP DEMO" if self.demo.active else "START DEMO")
        connected = self.serial.is_connected
        self.connect_btn.setEnabled(not connected)
        self.disconnect_btn.setEnabled(connected)
        self.port_combo.setEnabled(not connected)
        self.start_cam_btn.setEnabled(self.worker is None)
        self.stop_cam_btn.setEnabled(self.worker is not None)
        self.camera_combo.setEnabled(self.worker is None)
        if estop:
            self._set_banner("EMERGENCY STOP ACTIVE - press RESUME to continue", "err")
        elif not self.demo.active:
            self._set_banner("", "info")

    def _set_banner(self, text: str, level: str) -> None:
        self.banner.setVisible(bool(text))
        if text and self.banner.text() != text:
            self.banner.setText(text)
        if self.banner.property("level") != level:      # re-polish only when the colour really changes
            self.banner.setProperty("level", level)
            self.banner.style().unpolish(self.banner)
            self.banner.style().polish(self.banner)

    # ------------------------------------------------------------------ ports / serial
    def refresh_ports(self) -> None:
        previous = self.port_combo.currentData()
        self.port_combo.clear()
        ports = SerialController.list_ports()
        for device, description in ports:
            self.port_combo.addItem(f"{device}  -  {description}", device)
        if not ports:
            self.port_combo.addItem("(no COM ports found)", "")
        index = self.port_combo.findData(previous)
        if index >= 0:
            self.port_combo.setCurrentIndex(index)

    def connect_esp32(self) -> None:
        port = self.port_combo.currentData()
        if self.serial.connect(port):
            set_badge(self.serial_badge, f"CONNECTED ({port})", "ok")
            self.say(f"Connected to {port}. Robot stays DISABLED until you press ENABLE ROBOT.", "ok")
        else:
            set_badge(self.serial_badge, "CONNECTION ERROR", "err")
            self.say("ESP32: CONNECTION ERROR - " + self.serial.last_error, "err")
        self._refresh_controls()

    def disconnect_esp32(self) -> None:
        if self.state == ENABLED:
            self.serial.send_command("DISABLE")
            self.state = DISABLED
        self.serial.disconnect()
        set_badge(self.serial_badge, "DISCONNECTED", "off")
        self.esp_state_label.setText(f"ESP32 firmware state: --   (baud {config.BAUD_RATE})")
        self._refresh_controls()

    def _link_lost(self) -> None:
        """Called when a serial read/write failed."""
        set_badge(self.serial_badge, "CONNECTION ERROR", "err")
        if self.state == ENABLED:
            self.state = DISABLED
        self.say("ESP32: CONNECTION ERROR - " + (self.serial.last_error or "link lost") +
                 ". The ESP32 holds a safe position by itself. Re-connect, then ENABLE ROBOT.", "err")
        self._refresh_controls()

    def _handle_serial_rx(self, now: float) -> None:
        was_connected = self.serial.is_connected
        for line in self.serial.poll():
            status = parse_status(line)
            if status:
                self.esp_state_label.setText(
                    f"ESP32 firmware state: {status['state']}   (baud {config.BAUD_RATE})")
                # A STATUS line sent just before RESUME/ENABLE was processed may still arrive: ignore for 1.5 s.
                if (status["state"] == "ESTOP" and self.state != ESTOP
                        and now - self._enabled_at > 1.5):
                    self.emergency_stop(from_esp32=True)
                elif (status["state"] == "DISABLED" and self.state == ENABLED
                      and now - self._enabled_at > 1.5):
                    self.state = DISABLED
                    self.say("ESP32 restarted or disabled itself. Press ENABLE ROBOT again.", "warn")
                    self._refresh_controls()
            elif line.startswith(("ERR", "WARN")):
                self.say(f"ESP32 says: {line}", "warn")
        if was_connected and not self.serial.is_connected:
            self._link_lost()

    # ------------------------------------------------------------------ camera
    def start_camera(self) -> None:
        if self.worker is not None:
            return
        ok, message = model_status()
        if not ok:
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Critical)
            box.setWindowTitle("HANDSYNC - model missing")
            box.setText("Hand Landmarker model not found." if "not found" in message else "Hand Landmarker model invalid.")
            box.setInformativeText(message)
            download = box.addButton("Download now", QMessageBox.AcceptRole)
            box.addButton("Cancel", QMessageBox.RejectRole)
            box.exec()
            if box.clickedButton() is not download:
                return
            QApplication.setOverrideCursor(Qt.WaitCursor)
            try:
                download_model()
            except HandTrackerError as exc:
                QApplication.restoreOverrideCursor()
                QMessageBox.critical(self, "Download failed", str(exc))
                return
            QApplication.restoreOverrideCursor()
            self.say("Model downloaded.", "ok")
        index = self.camera_combo.currentData()
        log.info("Starting camera %s", index)
        self.worker = CameraWorker(index, self.mirror_check.isChecked(), self.swap_check.isChecked(), self)
        self.worker.result_ready.connect(self._on_result)
        self.worker.camera_status.connect(self._on_camera_status)
        self.worker.fatal_error.connect(self._on_camera_error)
        self.worker.finished.connect(self._on_worker_finished)
        set_badge(self.camera_badge, "STARTING...", "warn")
        self.worker.start()
        self._refresh_controls()

    def stop_camera(self) -> None:
        worker = self.worker
        if worker is None:
            return
        worker.stop()
        worker.wait(4000)
        self._on_worker_finished()

    def _on_worker_finished(self) -> None:
        if self.worker is not None and self.worker.isRunning():
            return
        self.worker = None
        self.video.clear()
        self.video.setText("CAMERA OFF\nPress START CAMERA")
        self.fps_label.setText("FPS --")
        if "ERROR" not in self.camera_badge.text():
            set_badge(self.camera_badge, "OFF", "off")
        for arm in config.ARMS:
            set_badge(self.hand_badges[arm], "NOT DETECTED", "off")
        self._refresh_controls()

    def _on_camera_status(self, ok: bool, text: str) -> None:
        set_badge(self.camera_badge, text, "ok" if ok else "err")

    def _on_camera_error(self, message: str) -> None:
        set_badge(self.camera_badge, "ERROR", "err")
        self.say("CAMERA ERROR: " + message, "err")
        QMessageBox.critical(self, "HANDSYNC - camera / tracking error", message)
        if self.worker:
            self.worker.stop()

    def _on_vision_flags(self) -> None:
        if self.worker:
            self.worker.mirror = self.mirror_check.isChecked()

    def _on_swap_toggled(self, checked: bool) -> None:
        self.cal.swap_left_right = checked
        if self.worker:
            self.worker.swap = checked
        try:
            save_calibration(self.cal)
        except OSError as exc:
            self.say(f"Could not save calibration: {exc}", "warn")

    def _on_result(self, result: FrameResult) -> None:
        pixmap = QPixmap.fromImage(result.image).scaled(self.video.size(), Qt.KeepAspectRatio,
                                                         Qt.SmoothTransformation)
        self.video.setPixmap(pixmap)
        self.fps_label.setText(f"FPS {result.fps:4.1f}   |   hands: {result.hands_detected}")
        now = time.monotonic()
        self.mapper.update(result.observations, now)
        for arm in config.ARMS:
            obs = result.observations.get(arm)
            tracking = self.mapper.tracking_state(arm, now)
            if obs:
                level = "ok"
                text = f"TRACKING \u00B7 {obs.gesture}" if obs.gesture != "NEUTRAL" else "TRACKING"
            elif tracking == "UNCERTAIN":
                level, text = "warn", "UNCERTAIN (holding pose)"
            else:
                level, text = "off", "NOT DETECTED"
            set_badge(self.hand_badges[arm], text, level)

    # ------------------------------------------------------------------ robot state
    def toggle_enable(self) -> None:
        if self.state == ESTOP:
            return
        if self.state == ENABLED:
            self.serial.send_command("DISABLE")
            self.state = DISABLED
            self.say("Robot DISABLED. Servos hold their last position.", "warn")
        else:
            if not self.serial.is_connected:
                QMessageBox.information(self, "ESP32 not connected",
                                        "Connect the ESP32 first (or keep testing vision only).")
                return
            # Soft start: smoother restarts from HOME so the first commands are gentle.
            self.smoother.reset(self.cal.home_outputs())
            self.manual_targets = self.cal.home_outputs()
            self._sync_sliders_to(self.manual_targets)
            if not (self.serial.send_command("ENABLE")):
                self._link_lost()
                return
            self.state = ENABLED
            self._enabled_at = time.monotonic()
            self.say("Robot ENABLED. Keep hands clear of the arms.", "ok")
        self._refresh_controls()

    def emergency_stop(self, from_esp32: bool = False) -> None:
        log.warning("EMERGENCY STOP (from_esp32=%s)", from_esp32)
        self.state = ESTOP
        self.homing = False
        self.demo.stop()
        for _ in range(3):                      # repeat: cheap insurance against a lost byte
            self.serial.send_command("STOP")
        self.say("EMERGENCY STOP ACTIVE. Fix the problem, then press RESUME.", "err")
        self._refresh_controls()

    def resume_from_estop(self) -> None:
        if self.state != ESTOP:
            return
        if not self.serial.is_connected:
            self.state = DISABLED
            self.say("Emergency stop cleared, but the ESP32 is not connected.", "warn")
        elif self.serial.send_command("RESUME"):
            self.state = ENABLED
            self._enabled_at = time.monotonic()
            self.say("Resumed. Robot ENABLED.", "ok")
        else:
            self._link_lost()
            self.state = DISABLED
        log.info("Emergency stop cleared by user")
        self._refresh_controls()

    def set_mode(self, mode: str) -> None:
        self.control_mode = mode
        if mode == "MANUAL":      # start from where the robot is: no jump
            self.manual_targets = [int(round(v)) for v in self.smoother.values]
            self._sync_sliders_to(self.manual_targets)
        self.say(f"Mode: {mode}", "info")
        self._refresh_controls()

    def home_robot(self) -> None:
        if self.state == ESTOP:
            return
        self.demo.stop()
        self.homing = True
        if self.state == ENABLED:
            self.serial.send_command("HOME")
        self.say("Moving to HOME position...", "info")
        self._refresh_controls()

    def toggle_demo(self) -> None:
        if self.demo.active:
            self.demo.stop()
            self.mapper.reset()
            self.say("Demo stopped.", "info")
        else:
            if self.state == ESTOP:
                return
            if self.worker is None:
                self.start_camera()
            self.control_mode = "MIRROR"
            self.mode_mirror_btn.setChecked(True)
            self.homing = False
            self.demo.start(time.monotonic())
            self.say("Demo running. (Robot only moves if ENABLED.)", "info")
        self._refresh_controls()

    def hardware_test(self, delta: int) -> None:
        if self.state == ESTOP:
            return
        name = self.test_combo.currentData()
        servo = self.cal.servos[name]
        target = self.cal.clamp(name, servo.center + delta)
        self.control_mode = "MANUAL"
        self.mode_manual_btn.setChecked(True)
        if self.homing:
            self.homing = False
        self.manual_targets = [int(round(v)) for v in self.smoother.values]
        self.manual_targets[config.SERVO_CHANNELS[name]] = target
        self._sync_sliders_to(self.manual_targets)
        suffix = "" if self.state == ENABLED else "  (robot not enabled: nothing will move)"
        self.say(f"TEST {name}: target {target}\u00B0{suffix}", "info" if self.state == ENABLED else "warn")
        self._refresh_controls()

    def open_calibration(self) -> None:
        dialog = CalibrationDialog(self.cal, self)
        if dialog.exec() == QDialog.Accepted and dialog.result_calibration is not None:
            new_cal = dialog.result_calibration
            new_cal.swap_left_right = self.cal.swap_left_right
            self.cal = new_cal
            try:
                save_calibration(self.cal)
                self.say("Calibration saved.", "ok")
            except OSError as exc:
                self.say(f"Calibration applied but could not be saved: {exc}", "warn")
            self.manual_targets = [self.cal.clamp(n, v) for n, v in zip(config.SERVO_NAMES, self.manual_targets)]
            self._apply_calibration_to_ui()

    # ------------------------------------------------------------------ sliders
    def _sync_sliders_to(self, values: list) -> None:
        self._ignore_slider = True
        for name, slider in self.sliders.items():
            slider.setValue(self.cal.clamp(name, values[config.SERVO_CHANNELS[name]]))
        self._ignore_slider = False

    def _on_slider(self, name: str, value: int) -> None:
        if self._ignore_slider or self.control_mode != "MANUAL":
            return
        self.manual_targets[config.SERVO_CHANNELS[name]] = self.cal.clamp(name, value)

    # ------------------------------------------------------------------ control loop (25 Hz)
    def _compute_targets(self, now: float) -> list[int]:
        home = self.cal.home_outputs()
        if self.homing:
            if self.smoother.max_error(home) < config.HOME_DONE_TOLERANCE_DEG:
                self.homing = False
                self.mapper.reset()             # resume tracking from the home pose, no jump back
                self.manual_targets = list(home)
                self._sync_sliders_to(home)
                self.say("HOME reached. Tracking resumes.", "ok")
                self._refresh_controls()
            return home
        if self.demo.active:
            cmd = self.demo.update(now)
            if cmd.mode == "done":
                self.mapper.reset()
                self.say("Demo finished.", "ok")
                self._refresh_controls()
                return self.mapper.targets()
            self._set_banner(cmd.caption, "info")
            if cmd.mode == "home":
                return home
            targets = self.mapper.targets()
            if cmd.mode in ("gripper_open", "gripper_close"):
                for arm in config.ARMS:
                    targets[config.SERVO_CHANNELS[f"{arm}_gripper"]] = self.cal.gripper_angle(
                        arm, cmd.mode == "gripper_open")
            return targets
        if self.control_mode == "MANUAL":
            return [self.cal.clamp(n, v) for n, v in zip(config.SERVO_NAMES, self.manual_targets)]
        return self.mapper.targets()

    def _on_tick(self) -> None:
        now = time.monotonic()
        self._handle_serial_rx(now)
        targets = self._compute_targets(now)
        if self.state == ESTOP:
            values = list(self.smoother.values)          # frozen
        else:
            values = self.smoother.step(targets)
        outputs = [self.cal.clamp(name, v) for name, v in zip(config.SERVO_NAMES, values)]   # final safety clamp

        for name, value in zip(config.SERVO_NAMES, outputs):
            self.value_labels[name].setText(f"{value}\u00B0")
        if self.control_mode != "MANUAL" or self.state == ESTOP:
            self._sync_sliders_to(outputs)

        if not self.serial.is_connected:
            return
        ok = self.serial.send_angles(outputs) if self.state == ENABLED else self.serial.send_command("PING")
        if not ok:
            self._link_lost()

    # ------------------------------------------------------------------ shutdown
    def closeEvent(self, event) -> None:  # noqa: N802 (Qt naming)
        self.timer.stop()
        self.demo.stop()
        if self.serial.is_connected:
            self.serial.send_command("DISABLE")
        self.stop_camera()
        self.serial.disconnect()
        log.info("HANDSYNC closed")
        super().closeEvent(event)
